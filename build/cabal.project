packages: ., assets
index-state: 2026-09-17T20:21:20Z
optimization: 1
tests: True

-- GHC 9.14/base 4.22 and containers 0.8 exceed these packages' declared
-- bounds. Keep exceptions package-specific and verify compilation/regressions;
-- serialise/time uses the already selected modern time API (+newtime15).
allow-newer: opaleye:base, postgresql-simple:base, postgresql-simple:template-haskell, postgresql-simple:containers, postgresql-simple:aeson, serialise:base, serialise:time, serialise:containers, cborg:base, cborg:containers

-- Retain the Aeson exponent and X.509 Name Constraints security fixes.
constraints: aeson >=2.2.5.1, crypton-x509 >=1.9.1, crypton-x509-validation >=1.9.1

-- Immutable base-only capability preparation library.
source-repository-package
  type: git
  location: https://github.com/freewillydev/operation-capabilities.git
  tag: 86c5b86078bc6fe9b9130a28d9de600a339f6221

-- Run library tests separately; bridge-test exercises the pinned integration.
package operation-capabilities
  tests: False
