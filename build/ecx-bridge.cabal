cabal-version: 3.14
name: ecx-bridge
version: 0.1.0.0
synopsis: ECX bridge with explicit payment funding
license: MIT
license-file: LICENSE
build-type: Simple
data-dir: ../src
data-files: test/fixtures/*.json, schema.sql
extra-source-files: ../src/test/CapabilityCompile.hs, ../src/test/formal/*.tla, ../src/test/formal/*.cfg,
  install.sh, update.sh, update-config.sh, install/*, scripts/*, ../src/chain/Bridge/bip39-english.txt

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: settings
  hs-source-dirs: ../src/src
  exposed-modules: Bridge.Domain, Bridge.Error, Bridge.Identity, Bridge.Wire, Bridge.Lifecycle, Bridge.Operation, Bridge.Operation.Internal
  build-depends: operation-capabilities ==0.1.3.0, base >=4.20 && <4.23, aeson >=2.2 && <2.4, text >=2.1 && <2.2, containers, bytestring, base16-bytestring, base58-bytestring, crypton >=1 && <1.2, ram >=0.22 && <0.23

library customer-api
  import: settings
  visibility: private
  hs-source-dirs: ../src/api
  exposed-modules: Bridge.API
  build-depends: base, ecx-bridge, text,
    servant >=0.20 && <0.21, servant-server >=0.20 && <0.21
  mixins: ecx-bridge hiding (Bridge.Operation.Internal)

library store
  import: settings
  visibility: private
  hs-source-dirs: ../src/runtime
  exposed-modules: Bridge.Store, Bridge.Fence
  other-modules: Bridge.Store.Schema, Bridge.Store.Catalog, Bridge.Store.Backup, Bridge.Store.Projection, Bridge.Store.Provision, Paths_ecx_bridge
  autogen-modules: Paths_ecx_bridge
  build-depends: base, ecx-bridge, ecx-bridge:chain, aeson, bytestring, text, containers,
    crypton, base16-bytestring, time, directory, filepath, unix, process, http-client, network, scientific, opaleye ==0.10.8.0, postgresql-simple >=0.7 && <0.8,
    product-profunctors >=0.11 && <0.12

library chain
  import: settings
  visibility: public
  hs-source-dirs: ../src/chain
  other-modules: Bridge.NativeBackup, Bridge.NativeHistory
  exposed-modules: Bridge.NativeKey, Bridge.Wallet, Bridge.File, Bridge.AdminStatus, Bridge.AdminKey, Bridge.RPC, Bridge.Native, Bridge.NativeObservation, Bridge.NativePayment, Bridge.Solana, Bridge.SolanaObservation, Bridge.SolanaMessage, Bridge.SolanaHelper, Bridge.SolanaPayment, Bridge.SolanaDeposit, Bridge.PaymentObservation, Bridge.PaymentSource
  build-depends: base, ecx-bridge, aeson, bytestring, text, scientific,
    filepath, http-client, http-client-tls, http-types, binary, containers, base58-bytestring,
    base64-bytestring, crypton, ram, unix, template-haskell, transformers, network, directory, time
  c-sources: ../src/cbits/native_key.c
  pkgconfig-depends: libsecp256k1 >=0.4 && <0.9

-- Closed associated-token-account setup operations used before installation.
library administration
  import: settings
  visibility: public
  hs-source-dirs: ../src/administration
  exposed-modules: Token, Token.Network, Token.Operation
  build-depends: base, ecx-bridge, ecx-bridge:chain, aeson, bytestring, text,
    unix, crypton, ram, base64-bytestring

library workflow
  import: settings
  visibility: private
  hs-source-dirs: ../src/workflow
  other-modules: Bridge.Credentials
  exposed-modules: Bridge.Observer, Bridge.Payment, Bridge.Signer, Bridge.Critical, Bridge.Reconciliation, Bridge.Admission, Bridge.Order, Bridge.Web, Bridge.Config, Bridge.Control, Bridge.Recovery
  build-depends: operation-capabilities ==0.1.3.0, base, ecx-bridge, ecx-bridge:customer-api, ecx-bridge:store,
    ecx-bridge:chain, aeson, bytestring, text, time, containers, http-client, servant, servant-server,
    async, transformers, stm, ram, base64-bytestring, crypton, crypton-pem, crypton-x509, http-types, wai, warp, warp-tls, filepath, unix,
    servant-client, http-client-tls, crypton-connection, tls, crypton-x509-store, directory, network, binary, postgresql-simple

-- Pure compiler contracts with isolated trace effects; no production IO instances.
test-suite operation-test
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: ../src/test
  main-is: OperationCheck.hs
  build-depends: base, ecx-bridge, operation-capabilities ==0.1.3.0, text,
    QuickCheck >=2.15 && <2.19

test-suite bridge-test
  import: settings
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
  type: exitcode-stdio-1.0
  hs-source-dirs: ../src/test, ../src/app
  main-is: Main.hs
  build-tool-depends: ecx-bridge:ecx-bridge
  other-modules: RestoreGuide, RestoreNative, RestoreGuideCheck, Configure, InstallConfig, Reconfigure, ReconfigureFiles, ReconfigureServices, WalletRotation, RotationFiles, Upgrade, Bootstrap, NodeSetup, SetupPaths, ConfigureCheck, ChainCheck, NativePaymentCheck, SolanaPaymentCheck, ObservationCheck, SigningTransportCheck, LifecycleCheck, Paths_ecx_bridge
  autogen-modules: Paths_ecx_bridge
  build-depends: operation-capabilities ==0.1.3.0, base, ecx-bridge, ecx-bridge:customer-api, ecx-bridge:chain, ecx-bridge:store, ecx-bridge:workflow, servant, aeson, text, containers,
    QuickCheck >=2.15 && <2.19, bytestring, scientific, http-client, base64-bytestring, wai, wai-extra, warp, http-types, directory, unix, filepath,
    ecx-build-assets, ecx-bridge:administration, process, async, network, crypton, ram, time, data-default, crypton-pem, crypton-x509, crypton-x509-validation, crypton-x509-store, base58-bytestring, iproute >=1.7 && <1.8

executable ecx-bridge
  import: settings
  hs-source-dirs: ../src/app
  main-is: Main.hs
  other-modules: RestoreActivate, RestoreGuide, RestoreNative, Menu, Configure, InstallConfig, Reconfigure, ReconfigureFiles, ReconfigureServices, WalletRotation, RotationFiles, Bootstrap, NodeSetup, SetupPaths, Upgrade, Paths_ecx_bridge
  autogen-modules: Paths_ecx_bridge
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  build-depends: base, ecx-bridge, ecx-bridge:workflow, ecx-bridge:chain,
    ecx-bridge:store, ecx-build-assets, aeson, bytestring, text,
    postgresql-simple, http-client, network, unix, filepath, directory, process, crypton, ram, containers, base58-bytestring, ecx-bridge:administration, iproute >=1.7 && <1.8

-- Explicitly invoked against a disposable current-schema database, never live custody.
executable ecx-store-check
  import: settings
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
  hs-source-dirs: ../src/test, ../src/runtime, ../src/workflow
  main-is: StoreCheck.hs
  other-modules: ProvisionCheck, Bridge.Fence, Bridge.Store, Bridge.Store.Schema, Bridge.Store.Catalog, Bridge.Store.Backup, Bridge.Store.Projection, Bridge.Store.Provision, Bridge.Observer, Bridge.Payment, Bridge.Signer, Bridge.Critical, Bridge.Reconciliation, Bridge.Admission, Bridge.Order, Bridge.Web, Bridge.Config, Bridge.Control, Bridge.Recovery, Bridge.Credentials, Paths_ecx_bridge
  autogen-modules: Paths_ecx_bridge
  build-depends: operation-capabilities ==0.1.3.0, base, async, ecx-bridge, ecx-bridge:customer-api, ecx-bridge:chain, http-client, servant, servant-server, aeson, bytestring,
    base64-bytestring, containers, text, crypton, base16-bytestring, time, directory, scientific, opaleye, postgresql-simple, product-profunctors, QuickCheck,
    transformers, stm, ram, crypton-pem, crypton-x509, http-types, wai, wai-extra, warp, warp-tls, filepath, unix,
    servant-client, http-client-tls, crypton-connection, tls, crypton-x509-store, process, network, binary
